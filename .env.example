# The Flying Bus - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Thirdweb Configuration
# Get these from https://thirdweb.com/dashboard
VITE_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here
VITE_THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here
VITE_WALLET_PRIVATE_KEY=your_wallet_private_key_here
VITE_POLYGON_RPC_URL=https://polygon-rpc.com

# Supabase Configuration
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration
VITE_API_URL=http://localhost:3000

# Site Configuration (for invitation URLs)
# Development: http://localhost:8080
# Production: https://theflyingbus.org
VITE_SITE_URL=http://localhost:8080