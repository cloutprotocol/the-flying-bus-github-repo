# Supabase Edge Functions Environment Configuration Template
# This file shows the structure for Supabase Edge Function environment variables
# Set these using: supabase secrets set VARIABLE_NAME=value --project-ref your-project-ref

# Email Service Configuration
# Get Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=admin@yourdomain.com
RESEND_FROM_NAME="Your App Name"

# Supabase Configuration (automatically provided by Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY is automatically set by Supabase

# Email Configuration
EMAIL_RATE_LIMIT_PER_HOUR=100
EMAIL_RATE_LIMIT_PER_DAY=1000
TOKEN_EXPIRATION_HOURS=168
MAX_RETRY_ATTEMPTS=3

# Site Configuration
# Development: http://localhost:8080
# Production: https://yourdomain.com
SITE_BASE_URL=http://localhost:8080

# Security Configuration
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true
# Development: http://localhost:8080,http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Monitoring Configuration
ENABLE_METRICS=true
LOG_LEVEL=info
ALERT_EMAIL=admin@yourdomain.com