# Wallet Configuration
# Copy values from wallet/.env.example and fill in your actual values

# Thirdweb Configuration
# Get these from https://thirdweb.com/dashboard
THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here
WALLET_PRIVATE_KEY=your_wallet_private_key_here
POLYGON_RPC_URL=https://polygon-rpc.com

# Supabase Configuration
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Token Contract Configuration
TOKEN_CONTRACT_ADDRESS=0x1401FCDe7ed44b5BE2E448bab2254Ab0709258b8

# API Configuration
API_URL=http://localhost:3000